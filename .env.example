# Local development names only. Do not put real secrets in this file.
# Web local Supabase URL must be loopback. Mobile local may use an approved LAN host.
# EAS preview and Vercel preview use staging, never a laptop and never production.
#
# Local email magic link: after `scripts/bootstrap-local-auth.ts`, open the message
# in the local Supabase mail catcher (Inbucket) and use that link. Do not insert
# login users with SQL.

EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Not for Expo or Next public bundles.
# The auth bootstrap script reads this from `supabase status` when it is unset.
# Do not add it to mobile or web client schemas.
SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SECRET_KEY=
