# Web local Supabase URL must be loopback.
# Preview deployments use staging, not production.

NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_RELEASE=
# OAuth client IDs/app IDs are public identifiers. Keep providers disabled until
# their matching Supabase staging provider configuration and callbacks are ready.
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_SIGN_IN_ENABLED=false
NEXT_PUBLIC_FACEBOOK_OAUTH_CLIENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
