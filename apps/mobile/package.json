{
  "name": "@stable/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "test": "jest --watchAll=false",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@stable))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "moduleNameMapper": {
      "^react$": "<rootDir>/node_modules/react/index.js",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "expo-doctor": "1.20.4",
    "jest-expo": "~57.0.5",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@sentry/react-native": "~7.11.0",
    "@stable/auth": "workspace:*",
    "@stable/config": "workspace:*",
    "@stable/contracts": "workspace:*",
    "@stable/current-club-context": "workspace:*",
    "@stable/design-tokens": "workspace:*",
    "@stable/observability": "workspace:*",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.52.0",
    "posthog-react-native": "^4.78.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4"
  }
}
