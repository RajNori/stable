# Mobile local URL may be loopback, 10.0.2.2, or an approved LAN host.
# It must not be a staging or production project ref.
# Preview builds set EXPO_PUBLIC_APP_ENV=staging and a staging URL.

EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
