{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "local"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    },
    "testflight": {
      "extends": "preview",
      "distribution": "store",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging"
      }
    },
    "play-internal": {
      "extends": "preview",
      "distribution": "store",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "play-internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
